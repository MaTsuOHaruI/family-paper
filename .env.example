# Supabase の接続情報（クライアントに置けるのは「公開用」の値だけ）。
# このファイルを .env にコピーして値を設定する。.env は Git に入れない（SEC-004）。
#
# 使ってはいけないもの: service_role キー、sb_secret_ で始まるキー、各種 API Secret。
# （設定するとアプリが起動時にエラーで止める。AI / OCR の秘密鍵は将来サーバー側に置く）

# Supabase ダッシュボード > Project Settings > API の Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 同じ画面の anon（public）キー、または publishable キー
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
